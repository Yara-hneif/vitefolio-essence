{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["jest", "@testing-library/jest-dom"]
  },
  "include": [
    "src",
    "../jest.setup.js",
    "**/*.test.ts",
    "**/*.test.tsx"
  ],
  "exclude": ["node_modules", "dist"]
}
